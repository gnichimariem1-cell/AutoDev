# URL de l'API Ollama utilisee par le PO Agent pour generer les User Stories.
# En local (hors Docker) : http://localhost:11434/api/generate
# Depuis Docker, pour joindre l'Ollama installe sur la machine hote : http://host.docker.internal:11434/api/generate
OLLAMA_URL=http://localhost:11434/api/generate

# Modele Ollama a utiliser (doit avoir ete recupere avec `ollama pull`).
OLLAMA_MODEL=qwen3

# Compte Claude utilise par les agents (Architect, Developer, Frontend, Dockerization).
# .env est charge au demarrage de l'app : ces variables sont transmises a `claude`.
# Option 1 - cle API (facturee a l'organisation Console qui l'a emise) :
ANTHROPIC_API_KEY=
# Option 2 - session Claude dediee au projet, separee de votre session personnelle.
# Chemin absolu, puis s'y connecter une fois : CLAUDE_CONFIG_DIR=<chemin> claude, puis /login.
# Laisser ANTHROPIC_API_KEY vide dans ce cas (la cle est prioritaire sur la session).
# CLAUDE_CONFIG_DIR=/home/<utilisateur>/.claude-projet

# Docker Validation Agent : hote ou joindre les ports publies par la config generee.
# En local : localhost. Si le pipeline tourne dans Docker (avec le socket Docker monte) :
# host.docker.internal. Sans acces a Docker, la validation est simplement ignoree.
DOCKER_VALIDATION_HOST=localhost
# Delais (secondes) pour le build des images et le demarrage des services.
DOCKER_BUILD_TIMEOUT=900
DOCKER_DEMARRAGE_TIMEOUT=120

# Sauvegarde de l'etat du pipeline apres chaque etape (reprise apres plantage).
# Supprimer ce fichier efface l'historique des runs (make nettoyer-sauvegardes).
CHECKPOINT_DB=checkpoints/pipeline.sqlite
