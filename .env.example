# URL de l'API Ollama utilisee par le PO Agent pour generer les User Stories.
# En local (hors Docker) : http://localhost:11434/api/generate
# Depuis Docker, pour joindre l'Ollama installe sur la machine hote : http://host.docker.internal:11434/api/generate
OLLAMA_URL=http://localhost:11434/api/generate

# Modele Ollama a utiliser (doit avoir ete recupere avec `ollama pull`).
OLLAMA_MODEL=qwen3

# Cle API Anthropic. Necessaire pour que Claude Code (agent Developer) puisse
# generer/corriger le code en mode non-interactif dans le conteneur Docker.
# Alternative : monter la session Claude Code deja authentifiee sur l'hote
# (voir les volumes commentes dans docker-compose.yml) et laisser cette cle vide.
ANTHROPIC_API_KEY=
